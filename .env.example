# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mediflow?schema=public"

# JWT — SEPARATE secrets for access and refresh tokens.
# Each MUST be at least 32 characters.
# Generate with: openssl rand -base64 32
#
# ⚠️ BREAKING CHANGE (Phase 1.3): JWT_SECRET has been removed.
# All existing sessions (access + refresh tokens) are invalidated.
# Every logged-in user must log in again after deploy.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# OTP Delivery
# If set, OTPs will be delivered via Resend email (production).
# If not set, OTPs are logged to console and returned in dev API responses.
RESEND_API_KEY=

# Vercel Cron Secret
# Used to authenticate automated cron job requests from Vercel.
# Generate with: openssl rand -hex 32
# Add to your local .env and to Vercel Project Settings -> Environment Variables.
CRON_SECRET=

# Default Admin Bootstrapping (Used by npm run create-admin)
# Set these in your local .env to provision or reset your default admin credentials with zero CLI flags.
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_NAME=

